{
  "$comment": "DHL Corporate — a keen-docs-authored OVERLAY theme (base: core). A deliberate stress-test of the theming system against design/dhl.html: signature DHL yellow navbar + red accents, Archivo display type. Hand-authored, marked local in keendocs.json.",
  "name": "DHL Corporate",
  "id": "dhl",
  "version": "1.0.0",
  "description": "docs.dhl.com imagined — DHL yellow top bar with red logo, red accents, Archivo headings. Full-width enterprise 3-pane shell.",
  "author": "KeenMate",
  "license": "MIT",
  "base": "core",

  "modeCssClass": "pc-mode-{mode}",
  "variantCssClass": "pa-color-{variant}",

  "colorVariants": [
    {
      "id": "",
      "name": "Default",
      "file": "dist/dhl.css",
      "modes": [
        {
          "id": "light",
          "name": "Light",
          "default": true,
          "colors": { "accent": "#D40511", "background": "#ffffff", "surface": "#ffffff", "text": "#1a1a1a", "header": "#FFCC00", "sidebar": "#ffffff" }
        },
        {
          "id": "dark",
          "name": "Dark",
          "colors": { "accent": "#ff5a5f", "background": "#15181c", "surface": "#1a1e23", "text": "#e8eaed", "header": "#FFCC00", "sidebar": "#14171b" }
        }
      ]
    }
  ],

  "fonts": {
    "family": "Archivo, Inter, system-ui, sans-serif",
    "url": "https://fonts.google.com/specimen/Archivo"
  },

  "keendocs": {
    "contract": "1.0",
    "toc": { "show": true, "placement": "right-rail" },
    "brand": { "logo": "/themes/dhl/assets/dhl-logo.svg", "label": "Developer Docs" },
    "header": {
      "nav": "hub",
      "links": "off",
      "resolve": false,
      "cta": { "label": "GitHub", "url": "https://github.com/keenmate", "icon": "★", "style": "secondary" }
    },
    "versionControl": {
      "type": "web-multiselect",
      "label": "@keenmate/web-multiselect",
      "module": "https://cdn.jsdelivr.net/npm/@keenmate/web-multiselect@2.0.0-rc01/dist/multiselect.js",
      "style": "https://cdn.jsdelivr.net/npm/@keenmate/web-multiselect@2.0.0-rc01/dist/style.css"
    },
    "fonts": {
      "href": "https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,700;1,900&family=Barlow+Semi+Condensed:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap",
      "body": "'Inter', system-ui, sans-serif",
      "heading": "'Archivo', 'Barlow Semi Condensed', system-ui, sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, monospace"
    }
  }
}
